<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Solar.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Solar.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                通用值转换器放在应用级资源里，所有页面都能直接引用。
                原先各页面在自己的 Page.Resources 里分别声明，漏声明一个就会在
                导航到该页时抛 "Cannot find a resource with the given key" 并闪退。
            -->
            <conv:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
            <conv:VisibleWhenTextConverter x:Key="VisibleWhenText" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:ModLoaderDisplayConverter x:Key="ModLoaderDisplay" />

            <!--
                TitleBar 的返回键在禁用时默认会填一块 ControlFillColorDisabledBrush 灰底，
                在标题栏上看起来像个突兀的方块。标题栏的其它按钮平时都是透明的，
                这里让返回键禁用时也保持透明，只靠箭头变灰表示不可用。
            -->
            <SolidColorBrush x:Key="TitleBarBackButtonBackgroundDisabled" Color="Transparent" />

            <!--
                标题栏高度。默认 32，按钮的悬停背景只有 28 高、紧贴窗口顶边，
                与左侧留白比例失衡。放到 40（与 MainWindow 的标题栏行高一致），
                悬停背景变成 36 高，上下留白和左边距看起来接近了。
            -->
            <x:Double x:Key="TitleBarCompactHeight">40</x:Double>

            <!--
                卡片容器：遵循 WinUI 3 的 Card 视觉规范（卡片底色 + 1px 描边 + 系统控件圆角），
                颜色全部取自 ThemeResource，自动适配浅色/深色/高对比度主题。
            -->
            <Style x:Key="SolarCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!--
                主页「启动游戏」按钮的主色。
                Windows 不像 Material Design 3 那样提供一整套由种子色推导的动态色板，
                但系统主题字典里有两类可以直接用的颜色：
                  · 强调色（SystemAccentColor / AccentFillColor*）——跟随用户在「设置 → 个性化」里选的主题色
                  · 系统语义色（SystemFillColorSuccess / Caution / Critical / Attention）——固定色相，随浅色/深色主题换明度
                启动是「开始做一件事」，用系统语义色里的成功绿比强调色更醒目，
                也和各页面其它强调色按钮（保存、登录）区分开。
                这里不写死任何色值：Color 取 ThemeResource SystemFillColorSuccess，
                主题切换时会跟着重新解析；悬停/按下沿用 WinUI 对强调色的做法，用降低不透明度表示。
            -->
            <SolidColorBrush x:Key="SolarLaunchButtonBackgroundBrush" Color="{ThemeResource SystemFillColorSuccess}" />
            <SolidColorBrush
                x:Key="SolarLaunchButtonBackgroundPointerOverBrush"
                Color="{ThemeResource SystemFillColorSuccess}"
                Opacity="0.9" />
            <SolidColorBrush
                x:Key="SolarLaunchButtonBackgroundPressedBrush"
                Color="{ThemeResource SystemFillColorSuccess}"
                Opacity="0.8" />
            <SolidColorBrush
                x:Key="SolarLaunchButtonBackgroundDisabledBrush"
                Color="{ThemeResource SystemFillColorSuccess}"
                Opacity="0.35" />

            <!-- 页面内容的标准内边距与间距（4px 网格） -->
            <Thickness x:Key="SolarPagePadding">24,16,24,16</Thickness>
            <x:Double x:Key="SolarSectionSpacing">24</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
