<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Solar.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                卡片容器：遵循 WinUI 3 的 Card 视觉规范（卡片底色 + 1px 描边 + 系统控件圆角），
                颜色全部取自 ThemeResource，自动适配浅色/深色/高对比度主题。
            -->
            <Style x:Key="SolarCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- 页面内容的标准内边距与间距（4px 网格） -->
            <Thickness x:Key="SolarPagePadding">24,16,24,16</Thickness>
            <x:Double x:Key="SolarSectionSpacing">24</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
