<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Solar.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Solar.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                通用值转换器放在应用级资源里，所有页面都能直接引用。
                原先各页面在自己的 Page.Resources 里分别声明，漏声明一个就会在
                导航到该页时抛 "Cannot find a resource with the given key" 并闪退。
            -->
            <conv:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
            <conv:VisibleWhenTextConverter x:Key="VisibleWhenText" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:ModLoaderDisplayConverter x:Key="ModLoaderDisplay" />

            <!--
                卡片容器：遵循 WinUI 3 的 Card 视觉规范（卡片底色 + 1px 描边 + 系统控件圆角），
                颜色全部取自 ThemeResource，自动适配浅色/深色/高对比度主题。
            -->
            <Style x:Key="SolarCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- 页面内容的标准内边距与间距（4px 网格） -->
            <Thickness x:Key="SolarPagePadding">24,16,24,16</Thickness>
            <x:Double x:Key="SolarSectionSpacing">24</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
