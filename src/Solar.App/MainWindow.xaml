<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Solar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Solar Launcher"
    mc:Ignorable="d">

    <!-- Mica 是 WinUI 3 推荐的窗口材质；系统不支持时自动回退为纯色 -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            使用 WinUI 3 的 TitleBar 控件承载标题栏：可拖拽、系统按钮随主题变色，
            并负责移动端的返回键与导航面板开关（导航规范要求开关放在标题栏）。
        -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Solar Launcher"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="240"
            PaneDisplayMode="Left"
            ItemInvoked="NavView_ItemInvoked"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" IsSelected="True" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="实例" Tag="instances">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                    下载是一个可展开的父项：NavigationViewItem 自带展开/收起箭头，
                    展开后露出六个子项，每项都导航到同一个下载页，只靠 Tag 区分分区。
                    SelectsOnInvoked=False 让父项只负责展开/收起、不参与选中——
                    否则点击它会把「下载」本身选上，出现父项高亮、页面却是子项内容的情况，
                    而且它自己的选中处理会把刚展开的子项又收回去。
                -->
                <NavigationViewItem
                    x:Name="DownloadNavItem"
                    Content="下载"
                    SelectsOnInvoked="False"
                    Tag="download">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Name="MinecraftNavItem" Content="Minecraft" Tag="download-minecraft" />
                        <NavigationViewItem Content="Mod" Tag="download-mod" />
                        <NavigationViewItem Content="光影" Tag="download-shaders" />
                        <NavigationViewItem Content="整合包" Tag="download-modpacks" />
                        <NavigationViewItem Content="资源包" Tag="download-resourcepacks" />
                        <NavigationViewItem Content="数据包" Tag="download-datapacks" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="账户" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
