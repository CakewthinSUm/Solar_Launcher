<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Solar.App.Views.AddonInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Solar.App.ViewModels"
    Title="{x:Bind ViewModel.Header, Mode=OneWay}"
    CloseButtonText="取消"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.InstallText, Mode=OneWay}"
    mc:Ignorable="d">

    <StackPanel Width="480" Spacing="12">
        <!-- 数据包只对存档生效，必须先选一个 -->
        <ComboBox
            Header="存档"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ViewModel.Worlds, Mode=OneWay}"
            PlaceholderText="先选择一个存档"
            SelectedItem="{x:Bind ViewModel.SelectedWorld, Mode=TwoWay}"
            Visibility="{x:Bind ViewModel.IsDataPack, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />

        <!-- 目标目录：等宽显示，用户能一眼看出装到哪个实例 -->
        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="目标目录" />
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                FontFamily="Consolas"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.TargetDirectory, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasTargetWarning, Mode=OneWay}"
            Message="{x:Bind ViewModel.TargetWarning, Mode=OneWay}"
            Severity="Warning" />

        <!-- 前置解析失败只是提示（仍能装主文件），所以按 Warning 显示；安装失败另有一条 Error -->
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!-- 清单：Mod 是主文件 + 递归展开的必选前置；其余类型只有文件本身 -->
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="将安装" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AddonInstallItemViewModel">
                        <CheckBox
                            IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                            IsEnabled="{x:Bind IsSelectable}"
                            Margin="0,2">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind VersionText}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind StateText}"
                                    Visibility="{x:Bind HasStateText, Converter={StaticResource VisibleWhenTrue}}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="2">
            <CheckBox
                Content="覆盖已存在的同名文件"
                IsChecked="{x:Bind ViewModel.OverwriteExisting, Mode=TwoWay}" />
            <TextBlock
                Margin="28,0,0,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.OverwriteHint, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasOverwriteHint, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
        </StackPanel>

        <!-- 进度：按文件数走（安装器只上报文件数，没有字节进度） -->
        <StackPanel
            Spacing="4"
            Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
            <ProgressBar Maximum="1" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
