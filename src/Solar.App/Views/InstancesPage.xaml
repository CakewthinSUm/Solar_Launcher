<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:conv="using:Solar.App.Converters"
    xmlns:models="using:Solar.Core.Instances"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
    </Page.Resources>

    <!-- 底部不留内边距，列表铺到窗口下边缘；留白由列表自己的 Padding 给 -->
    <Grid Padding="24,16,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="实例" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="每个实例可选择不同版本与加载器；游戏目录里已有的版本会自动导入。开启版本隔离后以该版本的版本文件夹为游戏目录，同版本实例共用存档与模组" />
            </StackPanel>

            <!-- 游戏目录里的版本变化（例如刚用官方启动器装了一个）随时可重新扫描 -->
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ScanCommand}"
                Content="扫描游戏目录" />

            <!-- 新建实例统一走创建页：选版本、选加载器与附加组件、一次装完 -->
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="NewInstance_Click"
                Content="新建实例"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>


        <Grid Grid.Row="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                Grid.Row="0"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Success" />

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Instances, Mode=OneWay}"
                Padding="0,0,0,16"
                SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameInstance">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind MinecraftVersion}" />
                                    <Run Text=" · " />
                                    <Run Text="{x:Bind DisplayLoader}" />
                                    <Run Text="{x:Bind IsolationBadge}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- 列表项内的操作按钮，点击由页面代码转发给 ViewModel -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Click="SetupInstance_Click" Content="设置" />
                                <Button Click="DeleteInstance_Click" Content="删除" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</views:PageBase>
