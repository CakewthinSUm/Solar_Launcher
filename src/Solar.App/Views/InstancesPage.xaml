<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:conv="using:Solar.App.Converters"
    xmlns:models="using:Solar.Core.Instances"
    xmlns:loaders="using:Solar.Core.Loaders"
    xmlns:vm="using:Solar.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
    </Page.Resources>

    <Grid Padding="{StaticResource SolarPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="实例" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="每个实例拥有独立的存档、模组与配置" />
        </StackPanel>

        <!-- 新建实例表单 -->
        <Border Grid.Row="1" Style="{StaticResource SolarCardStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Header="名称"
                        PlaceholderText="例如：生存服"
                        Text="{x:Bind ViewModel.NewInstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Grid.Column="1"
                        Header="游戏版本"
                        Text="{x:Bind ViewModel.NewInstanceVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="2"
                        Header="加载器"
                        ItemsSource="{x:Bind ViewModel.Loaders}"
                        SelectedItem="{x:Bind ViewModel.NewInstanceLoader, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModLoaderOption">
                                <TextBlock Text="{x:Bind Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox
                        Grid.Column="3"
                        Header="加载器版本"
                        IsEnabled="{x:Bind ViewModel.NeedsLoaderVersion, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.LoaderVersions, Mode=OneWay}"
                        PlaceholderText="原版无需选择"
                        SelectedItem="{x:Bind ViewModel.SelectedLoaderVersion, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="loaders:LoaderVersion">
                                <TextBlock Text="{x:Bind Version}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Grid.Column="4"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.CreateCommand}"
                        Content="新建"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.NeedsLoaderVersion, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.IsLoadingLoaderVersions, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.LoaderVersionHint, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                Grid.Row="0"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Success" />

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Instances, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameInstance">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind MinecraftVersion}" />
                                    <Run Text=" · " />
                                    <Run Text="{x:Bind DisplayLoader}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- 列表项内的操作按钮，点击由页面代码转发给 ViewModel -->
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="DeleteInstance_Click"
                                Content="删除" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</views:PageBase>
