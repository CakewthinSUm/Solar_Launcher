<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    mc:Ignorable="d">

    <!--
        设置页遵循 WinUI 3 设置页规范：
        标题 + 分组小标题 + 每个设置项一行（左说明、右控件），分组之间用 24px 间距。
    -->
    <ScrollViewer>
        <StackPanel
            Padding="{StaticResource SolarPagePadding}"
            Spacing="{StaticResource SolarSectionSpacing}">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="启动器与游戏运行参数" />
            </StackPanel>

            <!-- 游戏 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="游戏" />

                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="最大内存" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="分配给游戏的最大堆内存（MB）" />
                            </StackPanel>
                            <NumberBox
                                Grid.Column="1"
                                Width="160"
                                LargeChange="1024"
                                Maximum="32768"
                                Minimum="512"
                                SmallChange="512"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.MaxMemoryMb, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="下载线程数" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="并发下载资源的数量" />
                            </StackPanel>
                            <NumberBox
                                Grid.Column="1"
                                Width="160"
                                Maximum="32"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.DownloadThreads, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 游戏目录：未开启版本隔离的实例共用的 .minecraft -->
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="游戏目录（.minecraft）" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="未开启版本隔离的实例共用的存档、模组与配置目录。可直接指向官方启动器的 .minecraft 以复用已有内容；留空则使用程序目录下的 .minecraft。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                FontFamily="Consolas"
                                PlaceholderText="默认"
                                Text="{x:Bind ViewModel.MinecraftDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.BrowseMinecraftDirectoryCommand}"
                                Content="浏览…" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.UseDefaultMinecraftDirectoryCommand}"
                                Content="恢复默认" />
                        </Grid>

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap">
                            <Run Text="实际使用：" />
                            <Run Text="{x:Bind ViewModel.EffectiveMinecraftDirectory, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 账户 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="账户" />
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="微软应用客户端 ID" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="在 Azure 门户注册应用后获得。应用类型选「移动和桌面应用」，启用公共客户端流，重定向 URI 填 http://localhost，并在 aka.ms/mce-reviewappid 提交审核。"
                            TextWrapping="Wrap" />
                        <TextBox
                            FontFamily="Consolas"
                            PlaceholderText="00000000-0000-0000-0000-000000000000"
                            Text="{x:Bind ViewModel.MicrosoftClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Java -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Java" />

                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="已检测到的 Java" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DetectedJava, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Java 路径" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="留空则自动选择，也可手动填写 java.exe 的完整路径" />
                            </StackPanel>
                            <TextBox
                                Grid.Column="1"
                                Width="360"
                                PlaceholderText="自动"
                                Text="{x:Bind ViewModel.JavaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Button Command="{x:Bind ViewModel.DetectJavaCommand}" Content="重新检测" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 下载源 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="下载源" />

                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="版本清单地址" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="可替换为国内镜像以加速" />
                        </StackPanel>
                        <TextBox Text="{x:Bind ViewModel.VersionManifestUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Spacing="2">
                            <TextBlock Text="下载镜像" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="留空直连 Mojang。例如 BMCLAPI：https://bmclapi2.bangbang93.com"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox
                            PlaceholderText="直连"
                            Text="{x:Bind ViewModel.DownloadMirrorUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="关于" />
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="数据目录" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DataRoot}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</views:PageBase>
