<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    mc:Ignorable="d">

    <!--
        设置页遵循 WinUI 3 设置页规范：
        标题 + 分组小标题 + 每个设置项一行（左说明、右控件），分组之间用 24px 间距。
    -->
    <ScrollViewer>
        <StackPanel
            Padding="{StaticResource SolarPagePadding}"
            Spacing="{StaticResource SolarSectionSpacing}">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="启动器与游戏运行参数" />
            </StackPanel>

            <!-- 游戏 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="游戏" />

                <!-- 内存分配：自动 / 手动 -->
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="内存分配" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="决定启动游戏时给 JVM 的堆内存上限（-Xmx）"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.MemoryModeIndex, Mode=TwoWay}">
                            <RadioButton Content="自动分配" />
                            <RadioButton Content="手动配置" />
                        </RadioButtons>

                        <!-- 自动：说明算法与当前估算值 -->
                        <StackPanel
                            Spacing="4"
                            Visibility="{x:Bind ViewModel.IsAutomaticMemory, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="根据物理内存、当前可用内存和实例的模组数量自动计算；每次启动都会重新估算，后台程序多时会相应少给一些。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SystemMemoryText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.AutoMemoryPreview, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 手动：滑条 -->
                        <StackPanel
                            Spacing="4"
                            Visibility="{x:Bind ViewModel.IsManualMemory, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    Grid.Column="0"
                                    Maximum="{x:Bind ViewModel.MemorySliderMaximum, Mode=OneWay}"
                                    Minimum="{x:Bind ViewModel.MemorySliderMinimum}"
                                    StepFrequency="512"
                                    Value="{x:Bind ViewModel.MemorySliderValue, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="150"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.MemoryLimitText, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SystemMemoryText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="下载线程数" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="并发下载资源的数量" />
                            </StackPanel>
                            <NumberBox
                                Grid.Column="1"
                                Width="160"
                                Maximum="32"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.DownloadThreads, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 新建实例的版本隔离默认值 -->
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="新建实例的版本隔离" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开启隔离的实例使用自己的存档、模组与配置目录，不会与其它实例互相影响。带模组加载器的实例建议开启。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ComboBox
                            MinWidth="240"
                            SelectedIndex="{x:Bind ViewModel.NewInstanceIsolationIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="每次创建时询问" />
                            <ComboBoxItem Content="总是开启" />
                            <ComboBoxItem Content="总是关闭" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 游戏目录：未开启版本隔离的实例共用的 .minecraft -->
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="游戏目录（.minecraft）" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="未开启版本隔离的实例共用的存档、模组与配置目录。可直接指向官方启动器的 .minecraft 以复用已有内容；留空则使用程序目录下的 .minecraft。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                FontFamily="Consolas"
                                PlaceholderText="默认"
                                Text="{x:Bind ViewModel.MinecraftDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.BrowseMinecraftDirectoryCommand}"
                                Content="浏览…" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.UseDefaultMinecraftDirectoryCommand}"
                                Content="恢复默认" />
                        </Grid>

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap">
                            <Run Text="实际使用：" />
                            <Run Text="{x:Bind ViewModel.EffectiveMinecraftDirectory, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 账户 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="账户" />
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="微软应用客户端 ID" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="在 Azure 门户注册应用后获得。应用类型选「移动和桌面应用」，启用公共客户端流，重定向 URI 填 http://localhost，并在 aka.ms/mce-reviewappid 提交审核。"
                            TextWrapping="Wrap" />
                        <TextBox
                            FontFamily="Consolas"
                            PlaceholderText="00000000-0000-0000-0000-000000000000"
                            Text="{x:Bind ViewModel.MicrosoftClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Java -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Java" />

                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="已检测到的 Java" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DetectedJava, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Java 路径" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="留空则自动选择，也可手动填写 java.exe 的完整路径" />
                            </StackPanel>
                            <TextBox
                                Grid.Column="1"
                                Width="360"
                                PlaceholderText="自动"
                                Text="{x:Bind ViewModel.JavaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Button Command="{x:Bind ViewModel.DetectJavaCommand}" Content="重新检测" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 下载源 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="下载源" />

                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="版本清单地址" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="可替换为国内镜像以加速" />
                        </StackPanel>
                        <TextBox Text="{x:Bind ViewModel.VersionManifestUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Spacing="2">
                            <TextBlock Text="下载镜像" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="留空直连 Mojang。例如 BMCLAPI：https://bmclapi2.bangbang93.com"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox
                            PlaceholderText="直连"
                            Text="{x:Bind ViewModel.DownloadMirrorUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- Mod 源：Modrinth / CurseForge，默认走 MCIM 镜像 -->
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Mod 来源" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="「下载 → Mod」的搜索与下载走这两个源。国内直连官方经常超时，默认使用 MCIM 镜像（它同时代理 Modrinth 与 CurseForge，后者不需要 API Key）。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ComboBox
                            MinWidth="240"
                            SelectedIndex="{x:Bind ViewModel.ModSourcePreferenceIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="官方优先" />
                            <ComboBoxItem Content="镜像优先" />
                            <ComboBoxItem Content="仅镜像" />
                        </ComboBox>

                        <StackPanel Spacing="2">
                            <TextBlock Text="镜像地址" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="留空则只走官方地址"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox
                            PlaceholderText="https://mod.mcimirror.top"
                            Text="{x:Bind ViewModel.ModMirrorUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Spacing="2">
                            <TextBlock Text="CurseForge API Key" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="选填。留空时只能通过镜像访问 CurseForge；填了才会直连官方 API。启动器不分发 Key。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <!--
                            PasswordBox.Password 不能双向绑定，只能由代码回填与回写。
                            页面在导航到时把设置里的 Key 填进来（见 SettingsPage.xaml.cs）。
                        -->
                        <PasswordBox
                            x:Name="CurseForgeKeyBox"
                            PasswordChanged="CurseForgeKey_PasswordChanged"
                            PlaceholderText="留空" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="关于" />
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="数据目录" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DataRoot}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</views:PageBase>
