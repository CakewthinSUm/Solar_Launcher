<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:conv="using:Solar.App.Converters"
    xmlns:models="using:Solar.Core.Accounts"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
        <conv:VisibleWhenTextConverter x:Key="VisibleWhenText" />
    </Page.Resources>

    <Grid Padding="{StaticResource SolarPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="账户" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ActiveAccountSummary, Mode=OneWay}" />
        </StackPanel>

        <!-- 登录卡片 -->
        <Border Grid.Row="1" Style="{StaticResource SolarCardStyle}">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="微软账户" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="使用正版微软账户登录，需要在浏览器中输入一次性代码"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.SignInCommand}"
                            Content="登录"
                            IsEnabled="{x:Bind ViewModel.IsSigningIn, Mode=OneWay, Converter={StaticResource InvertBool}}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Command="{x:Bind ViewModel.CancelSignInCommand}"
                            Content="取消"
                            Visibility="{x:Bind ViewModel.IsSigningIn, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                    </StackPanel>
                </Grid>

                <!-- 设备码：登录过程中展示 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Visibility="{x:Bind ViewModel.HasDeviceCode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="在浏览器中打开下面的网址，输入此代码：" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="28"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DeviceCode, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DeviceCodeUri, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ProgressBar
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsSigningIn, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.LoginStatus, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.LoginStatus, Mode=OneWay, Converter={StaticResource VisibleWhenText}}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 账户列表 -->
        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                Grid.Row="0"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Success" />
            <InfoBar
                Grid.Row="0"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameAccount">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Username}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Uuid}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Click="SetActive_Click" Content="设为当前" />
                                <Button Click="Remove_Click" Content="移除" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</views:PageBase>
