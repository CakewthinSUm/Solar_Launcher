<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:controls="using:Solar.App.Views.Controls"
    xmlns:conv="using:Solar.App.Converters"
    xmlns:models="using:Solar.Core.Versions"
    xmlns:vm="using:Solar.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />

        <!-- 行悬停：透明画刷保证整行可命中，进入时换成浅色填充 -->
        <SolidColorBrush x:Key="VersionRowTransparentBrush" Color="Transparent" />
        <SolidColorBrush x:Key="VersionRowHoverBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
    </Page.Resources>

    <!-- 底部不留内边距，列表铺到窗口下边缘；留白由列表自己的 Padding 给 -->
    <Grid Padding="24,16,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 分区栏兼任页面标题：版本是「管理」的默认分区，其余三项切到内容页 -->
            <StackPanel Grid.Column="0" Spacing="4">
                <controls:ManageSectionBar x:Name="SectionBar" SectionSelected="SectionBar_SectionSelected" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="每个版本可独立选择加载器与组件；MC 文件夹里已有的版本会自动列出。开启隔离后，该版本的文件夹就是游戏目录，存档与模组都在里面" />
            </StackPanel>

            <!-- MC 文件夹里的版本变化（例如刚用官方启动器装了一个）随时可重新扫描 -->
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ScanCommand}"
                Content="刷新版本列表" />

            <!-- 新建版本统一走创建页：选版本、选加载器与附加组件、一次装完 -->
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="NewVersion_Click"
                Content="新建版本"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>


        <!--
            页面级滚动：分组本身用 Expander 折叠，组内不再套 ScrollViewer，
            否则会出现嵌套滚动。版本数量级不大，ItemsControl 不虚拟化反而更稳。
        -->
        <ScrollViewer
            Grid.Row="1"
            Padding="0,0,0,16"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VersionGroupViewModel">
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <Expander.Header>
                                    <Grid Padding="0,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.HeadingLevel="Level2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind CountText, Mode=OneWay}" />
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Spacing="0">
                                    <!-- 只有收藏夹会在为空时仍然显示，所以这条提示也只会出现在收藏夹里 -->
                                    <TextBlock
                                        Margin="12,4,12,8"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="还没有收藏的版本。点版本右侧的心形即可收藏。"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />

                                    <ItemsControl ItemsSource="{x:Bind Versions, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:GameVersion">
                                                <Border
                                                    Padding="12,8"
                                                    Background="{StaticResource VersionRowTransparentBrush}"
                                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                                    PointerEntered="VersionRow_PointerEntered"
                                                    PointerExited="VersionRow_PointerExited"
                                                    PointerMoved="VersionRow_PointerMoved">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 版本图标：自定义过就用图片，否则显示默认的文件夹图标 -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="36"
                                                            Height="36"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="6">
                                                            <Grid>
                                                                <FontIcon
                                                                    FontSize="18"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Glyph="&#xE8B7;"
                                                                    Visibility="{x:Bind HasIcon, Converter={StaticResource CollapsedWhenTrue}}" />
                                                                <Image
                                                                    Source="{x:Bind IconPath, Converter={StaticResource PathToImageSource}}"
                                                                    Stretch="UniformToFill"
                                                                    Visibility="{x:Bind HasIcon, Converter={StaticResource VisibleWhenTrue}}" />
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                                            <TextBlock
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{x:Bind MinecraftVersion}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{x:Bind DisplayLoader}" />
                                                                <Run Text="{x:Bind IsolationBadge}" />
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- 列表项内的操作按钮，点击由页面代码转发给 ViewModel -->
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal"
                                                            Spacing="8">
                                                            <!-- 心形快捷收藏：未收藏是轮廓，已收藏是实心 -->
                                                            <Button
                                                                Width="32"
                                                                Height="32"
                                                                Padding="0"
                                                                AutomationProperties.Name="收藏"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="Favorite_Click"
                                                                ToolTipService.ToolTip="收藏 / 取消收藏">
                                                                <Grid>
                                                                    <FontIcon
                                                                        FontSize="16"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Glyph="&#xEB51;"
                                                                        Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource CollapsedWhenTrue}}" />
                                                                    <FontIcon
                                                                        FontSize="16"
                                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                        Glyph="&#xEB52;"
                                                                        Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                                                </Grid>
                                                            </Button>

                                                            <Button Click="SetupVersion_Click" Content="设置" />
                                                            <Button Click="DeleteVersion_Click" Content="删除" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </ScrollViewer>
    </Grid>
</views:PageBase>
