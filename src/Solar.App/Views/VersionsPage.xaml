<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:controls="using:Solar.App.Views.Controls"
    xmlns:conv="using:Solar.App.Converters"
    xmlns:models="using:Solar.Core.Versions"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
    </Page.Resources>

    <!-- 底部不留内边距，列表铺到窗口下边缘；留白由列表自己的 Padding 给 -->
    <Grid Padding="24,16,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 分区栏兼任页面标题：版本是「管理」的默认分区，其余三项切到内容页 -->
            <StackPanel Grid.Column="0" Spacing="4">
                <controls:ManageSectionBar x:Name="SectionBar" SectionSelected="SectionBar_SectionSelected" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="每个版本可独立选择加载器与组件；MC 文件夹里已有的版本会自动列出。开启隔离后，该版本的文件夹就是游戏目录，存档与模组都在里面" />
            </StackPanel>

            <!-- MC 文件夹里的版本变化（例如刚用官方启动器装了一个）随时可重新扫描 -->
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ScanCommand}"
                Content="刷新版本列表" />

            <!-- 新建版本统一走创建页：选版本、选加载器与附加组件、一次装完 -->
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="NewVersion_Click"
                Content="新建版本"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>


        <Grid Grid.Row="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                Grid.Row="0"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Success" />

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}"
                Padding="0,0,0,16"
                SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameVersion">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 版本图标：自定义过就用图片，否则显示默认的文件夹图标 -->
                            <Border
                                Grid.Column="0"
                                Width="36"
                                Height="36"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <Grid>
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE8B7;"
                                        Visibility="{x:Bind HasIcon, Converter={StaticResource CollapsedWhenTrue}}" />
                                    <Image
                                        Source="{x:Bind IconPath, Converter={StaticResource PathToImageSource}}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind HasIcon, Converter={StaticResource VisibleWhenTrue}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind MinecraftVersion}" />
                                    <Run Text=" · " />
                                    <Run Text="{x:Bind DisplayLoader}" />
                                    <Run Text="{x:Bind IsolationBadge}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- 列表项内的操作按钮，点击由页面代码转发给 ViewModel -->
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Click="SetupVersion_Click" Content="设置" />
                                <Button Click="DeleteVersion_Click" Content="删除" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</views:PageBase>
