<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.VersionSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Padding="{StaticResource SolarPagePadding}"
            Spacing="{StaticResource SolarSectionSpacing}">

            <!-- 标题 -->
            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.VersionName, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.VersionSummary, Mode=OneWay}" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <!-- 启动 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="启动" />

                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <ToggleSwitch
                            Header="版本隔离"
                            IsOn="{x:Bind ViewModel.VersionIsolation, Mode=TwoWay}"
                            OffContent="关"
                            OnContent="开" />

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.IsolationHint, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap">
                            <Run Text="实际使用：" />
                            <Run Text="{x:Bind ViewModel.EffectiveGameDirectory, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="切换隔离不会搬动已有文件；开启后游戏目录就是该版本的文件夹。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 界面 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="界面" />

                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBox
                            Header="自定义游戏标题"
                            PlaceholderText="留空则显示默认标题（版本 id）"
                            Text="{x:Bind ViewModel.CustomWindowTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="修改游戏窗口左上角显示的标题，保存后下次启动生效。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 自定义 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="自定义" />

                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="版本 id"
                                PlaceholderText="版本文件夹名"
                                Text="{x:Bind ViewModel.VersionIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="版本 id 就是版本文件夹名。保存后文件夹、版本 JSON 与 jar 会一起改名，游戏运行中无法修改。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 图标预览：自定义过就用图片，否则显示默认的文件夹图标 -->
                            <Border
                                Grid.Column="0"
                                Width="48"
                                Height="48"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Grid>
                                    <FontIcon
                                        FontSize="24"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE8B7;"
                                        Visibility="{x:Bind ViewModel.HasIcon, Mode=OneWay, Converter={StaticResource CollapsedWhenTrue}}" />
                                    <Image
                                        Source="{x:Bind ViewModel.IconPath, Mode=OneWay, Converter={StaticResource PathToImageSource}}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind ViewModel.HasIcon, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="版本图标" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="PNG / JPG / BMP / GIF / ICO，保存后显示在版本列表里。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.PickIconCommand}" Content="选择图片" />
                            <Button Command="{x:Bind ViewModel.ClearIconCommand}" Content="恢复默认" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 保存 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</views:PageBase>
