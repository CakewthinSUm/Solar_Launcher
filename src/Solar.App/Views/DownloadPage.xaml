<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:models="using:Solar.Core.Models"
    mc:Ignorable="d">

    <!--
        六个分区由侧边栏「下载」下的子项切换，页面本身只负责按分区渲染内容，
        不再放第二层 tab，避免同一份导航出现两处入口。
    -->
    <Grid Padding="{StaticResource SolarPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SectionDescription, Mode=OneWay}" />
        </StackPanel>

        <!-- Minecraft：版本列表 -->
        <Grid
            Grid.Row="1"
            RowSpacing="12"
            Visibility="{x:Bind ViewModel.IsMinecraftSection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="正式版 " />
                <Run Text="{x:Bind ViewModel.LatestRelease, Mode=OneWay}" />
                <Run Text=" · 快照 " />
                <Run Text="{x:Bind ViewModel.LatestSnapshot, Mode=OneWay}" />
            </TextBlock>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    Grid.Column="0"
                    VerticalAlignment="Bottom"
                    Header="搜索"
                    PlaceholderText="版本号"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!--
                    ToggleSwitch 的 On/OffContent 描述的是开关当前状态，不是它控制的行为。
                    用 Header 说明开关的含义，状态文案只写“开 / 关”，避免歧义。
                -->
                <ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Header="显示快照版本"
                    IsOn="{x:Bind ViewModel.ShowSnapshots, Mode=TwoWay}"
                    OffContent="关"
                    OnContent="开" />
            </Grid>

            <ListView
                Grid.Row="2"
                ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:VersionSummary">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Id}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Type}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <InfoBar
                Grid.Row="2"
                VerticalAlignment="Top"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
        </Grid>

        <!-- 其余分区：暂为占位，待接入各自的来源后替换 -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="4"
            Visibility="{x:Bind ViewModel.IsPlaceholderSection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="尚未接入" />
        </StackPanel>
    </Grid>
</views:PageBase>
