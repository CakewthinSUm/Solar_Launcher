<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:models="using:Solar.Core.Models"
    mc:Ignorable="d">

    <!--
        这个页面只负责 Minecraft 版本列表；其余五个分区由 AddonDownloadPage 处理。
        底部不留内边距：版本列表要铺到窗口下边缘，否则滚到底会有一条空白带，
        看起来像最后一行被截断了（内边距改由列表自己的 Padding 提供）。
    -->
    <Grid Padding="24,16,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SectionDescription, Mode=OneWay}" />
        </StackPanel>

        <!-- Minecraft：版本列表 -->
        <Grid
            Grid.Row="1"
            RowSpacing="12"
            Visibility="{x:Bind ViewModel.IsMinecraftSection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="正式版 " />
                <Run Text="{x:Bind ViewModel.LatestRelease, Mode=OneWay}" />
                <Run Text=" · 快照 " />
                <Run Text="{x:Bind ViewModel.LatestSnapshot, Mode=OneWay}" />
            </TextBlock>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    Grid.Column="0"
                    VerticalAlignment="Bottom"
                    Header="搜索"
                    PlaceholderText="版本号"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!--
                    ToggleSwitch 的 On/OffContent 描述的是开关当前状态，不是它控制的行为。
                    用 Header 说明开关的含义，状态文案只写“开 / 关”，避免歧义。
                -->
                <ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Header="显示快照版本"
                    IsOn="{x:Bind ViewModel.ShowSnapshots, Mode=TwoWay}"
                    OffContent="关"
                    OnContent="开" />
            </Grid>

            <!--
                点一行进入创建实例页：装什么版本、带哪些组件都在那里选。
                SelectionMode=None + IsItemClickEnabled 让整行可点，但不高亮选中态。
            -->
            <ListView
                Grid.Row="2"
                IsItemClickEnabled="True"
                ItemClick="Version_Click"
                ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}"
                Padding="0,0,0,16"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:VersionSummary">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Id}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Type}" />
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <InfoBar
                Grid.Row="2"
                VerticalAlignment="Top"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
        </Grid>

    </Grid>
</views:PageBase>
