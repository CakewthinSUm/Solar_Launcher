<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:fmt="using:Solar.App.Formatting"
    xmlns:models="using:Solar.Core.Models"
    mc:Ignorable="d">

    <!--
        这个页面只负责 Minecraft 版本列表；其余五个分区由 AddonDownloadPage 处理。
        底部不留内边距：版本列表要铺到窗口下边缘，否则滚到底会有一条空白带，
        看起来像最后一行被截断了（内边距改由列表自己的 Padding 提供）。
    -->
    <Grid Padding="24,16,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SectionDescription, Mode=OneWay}" />
        </StackPanel>

        <!-- Minecraft：版本列表 -->
        <Grid
            Grid.Row="1"
            RowSpacing="12"
            Visibility="{x:Bind ViewModel.IsMinecraftSection, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="正式版 " />
                <Run Text="{x:Bind ViewModel.LatestRelease, Mode=OneWay}" />
                <Run Text=" · 快照 " />
                <Run Text="{x:Bind ViewModel.LatestSnapshot, Mode=OneWay}" />
            </TextBlock>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    Grid.Column="0"
                    VerticalAlignment="Bottom"
                    Header="搜索"
                    PlaceholderText="版本号"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />

                <!--
                    筛选面板必须内联在页面上：放进 Page.Resources 会失去 x:Bind 的命名空间。
                    Flyout 默认向上弹出，会盖住搜索行，所以指定向下弹出。
                -->
                <Button
                    x:Name="FilterButton"
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="筛选">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="260" Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="版本类型" />
                                <CheckBox Content="正式版" IsChecked="{x:Bind ViewModel.ShowReleases, Mode=TwoWay}" />
                                <CheckBox Content="快照" IsChecked="{x:Bind ViewModel.ShowSnapshots, Mode=TwoWay}" />
                                <CheckBox Content="预发布版" IsChecked="{x:Bind ViewModel.ShowPrereleases, Mode=TwoWay}" />
                                <CheckBox Content="远古 Beta" IsChecked="{x:Bind ViewModel.ShowOldBeta, Mode=TwoWay}" />
                                <CheckBox Content="远古 Alpha" IsChecked="{x:Bind ViewModel.ShowOldAlpha, Mode=TwoWay}" />

                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="发布年份" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="发布年份"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{x:Bind ViewModel.YearOptions}"
                                    SelectedIndex="{x:Bind ViewModel.YearIndex, Mode=TwoWay}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Command="{x:Bind ViewModel.ResetFiltersCommand}"
                                        Content="重置" />
                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Click="CloseFilter_Click"
                                        Content="完成"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE71C;" />
                        <TextBlock Text="筛选" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--
                点一行进入创建实例页：装什么版本、带哪些组件都在那里选。
                SelectionMode=None + IsItemClickEnabled 让整行可点，但不高亮选中态。
            -->
            <ListView
                Grid.Row="2"
                IsItemClickEnabled="True"
                ItemClick="Version_Click"
                ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}"
                Padding="0,0,0,16"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:VersionSummary">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Id}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind fmt:VersionDisplay.TypeLabel(Type, Id)}" />
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态：叠在列表上但不吃点击，滚动和行点击都不受影响 -->
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />

            <InfoBar
                Grid.Row="2"
                VerticalAlignment="Top"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
        </Grid>

    </Grid>
</views:PageBase>
