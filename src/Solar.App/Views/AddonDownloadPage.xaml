<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.AddonDownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:vm="using:Solar.App.ViewModels"
    mc:Ignorable="d">

    <!--
        底部不留内边距：列表要一直铺到窗口下边缘。
        否则滚动到底时会有一条空白带，看起来像内容被截断了。
    -->
    <Grid Padding="24,16,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SectionDescription, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 筛选与搜索 -->
        <Border Grid.Row="1" Style="{StaticResource SolarCardStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Mod / 光影 / 资源包 / 数据包：实例同时决定游戏版本与加载器，
                        搜出来的每一条都能直接装。没选实例时仍可浏览，只是不能安装。
                    -->
                    <ComboBox
                        Grid.Column="0"
                        Header="目标实例"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.Instances, Mode=OneWay}"
                        PlaceholderText="先创建实例才能安装"
                        SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.NeedsInstance, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />

                    <!-- 整合包会新建实例，所以按用户选的目标游戏版本过滤 -->
                    <ComboBox
                        Grid.Column="0"
                        Header="游戏版本"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.GameVersions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedGameVersion, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsModpack, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />

                    <ComboBox
                        Grid.Column="1"
                        Header="来源"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="Modrinth" />
                        <ComboBoxItem Content="CurseForge" />
                    </ComboBox>

                    <ComboBox
                        Grid.Column="2"
                        Header="排序"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="相关度" />
                        <ComboBoxItem Content="下载量" />
                        <ComboBoxItem Content="更新时间" />
                        <ComboBoxItem Content="最新发布" />
                    </ComboBox>
                </Grid>

                <!-- 两个源都只认英文名，占位文案里直接说明 -->
                <AutoSuggestBox
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="还没有实例，可以先浏览；安装前需要在「管理 → 实例」创建一个。"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ShowInstanceHint, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
            </StackPanel>
        </Border>

        <!--
            计数在左、「加载更多」贴右边缘，两者同一行同一字号。
            按钮保持标准尺寸，和右侧的进度环垂直居中。
        -->
        <Grid Grid.Row="2">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.ShowInlineBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowInlineBusy, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                <Button
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Content="加载更多"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
            </StackPanel>
        </Grid>

        <!-- 结果。列表一直铺到底，最后一行滚动上来时完整可见 -->
        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasDegradedHint, Mode=OneWay}"
                    Message="{x:Bind ViewModel.DegradedHint, Mode=OneWay}"
                    Severity="Warning" />
                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>

            <!--
                SelectionMode=None + IsItemClickEnabled：整行可点进详情，但不留选中态。
                禁用横向滚动：简介是长句，不关掉横向滚动模式时 ListView 会让整行宽于可视区。
            -->
            <ListView
                Grid.Row="1"
                IsItemClickEnabled="True"
                ItemClick="Addon_Click"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                Padding="0,0,0,16"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AddonCardViewModel">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                图标：加载失败时换成首字母方块（WebP 在 Win10 上可能解不了）。
                                占位块只在失败时出现——一直垫在下面的话，带透明通道的图标
                                会透出底下的字母，看起来像两图叠在一起。
                            -->
                            <Grid
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Top">
                                <Border
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource CollapsedWhenTrue}}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Initial}" />
                                </Border>
                                <Border
                                    CornerRadius="8"
                                    Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                    <Image
                                        ImageFailed="AddonIcon_ImageFailed"
                                        Source="{x:Bind IconUrl}"
                                        Stretch="Uniform" />
                                </Border>
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Summary}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind LoadersText}"
                                        Visibility="{x:Bind HasLoaders, Converter={StaticResource VisibleWhenTrue}}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="·"
                                        Visibility="{x:Bind HasLoaders, Converter={StaticResource VisibleWhenTrue}}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind SourceBadge}"
                                        Visibility="{x:Bind HasSourceBadge, Converter={StaticResource VisibleWhenTrue}}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DownloadsText}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind UpdatedText}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 搜索中且列表为空：内容区正中的大进度环，取代「没有结果」出现 -->
            <ProgressRing
                Grid.Row="1"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.ShowCenterBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowCenterBusy, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />

            <!-- 空状态 -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="4"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="没有结果" />
                <TextBlock
                    HorizontalAlignment="Center"
                    MaxWidth="420"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</views:PageBase>
