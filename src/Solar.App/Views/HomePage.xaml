<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:controls="using:Solar.App.Views.Controls"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel
                Padding="{StaticResource SolarPagePadding}"
                Spacing="{StaticResource SolarSectionSpacing}">

                <!-- 页面标题：使用系统 TitleTextBlockStyle，保证与系统应用一致的字号与字重 -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="主页" />
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="选择实例并开始游戏" />
                </StackPanel>

                <!-- 准备启动：选择要运行的实例 -->
                <Border Style="{StaticResource SolarCardStyle}" Padding="24">
                    <StackPanel Spacing="12">
                        <!-- 标题行：刷新按钮放在卡片右上角，用图标而不是文字 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="准备启动" />

                            <Button
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="刷新"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="刷新">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                        </Grid>

                        <ComboBox
                            Header="游戏实例"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name"
                            IsEnabled="{x:Bind ViewModel.IsLaunchCardOpen, Mode=OneWay, Converter={StaticResource InvertBool}}"
                            ItemsSource="{x:Bind ViewModel.Instances, Mode=OneWay}"
                            PlaceholderText="还没有实例"
                            SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}" />

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.SelectedInstanceSummary, Mode=OneWay}" />

                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.IsSignedIn, Mode=OneWay, Converter={StaticResource InvertBool}}"
                            Message="尚未登录微软账户，请先到「账户」页登录"
                            Severity="Warning" />
                    </StackPanel>
                </Border>

                <!-- 信息卡片：两列等宽，窄窗口下由 NavigationView 自身收缩，卡片保持最小可读宽度 -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SolarCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Java 运行时" />
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.JavaStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="实例数量 " />
                                <Run Text="{x:Bind ViewModel.Instances.Count, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SolarCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="当前账户" />
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.AccountSummary, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 状态提示：InfoBar 是 WinUI 3 规定的行内提示控件 -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Message="正在加载…"
                    Severity="Informational" />
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />
                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="Success" />

                <!-- 底部留白：高度 = 按钮高度 + 下边距，滚到底时内容不会被底部 Dock 遮挡 -->
                <Border Height="72" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 Dock：包含启动按钮和展开的进度卡片；盖在 ScrollViewer 之上 -->
        <controls:LaunchDock ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
    </Grid>
</views:PageBase>
