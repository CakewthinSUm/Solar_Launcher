<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Padding="{StaticResource SolarPagePadding}"
            Spacing="{StaticResource SolarSectionSpacing}">

            <!-- 页面标题：使用系统 TitleTextBlockStyle，保证与系统应用一致的字号与字重 -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="主页" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="选择实例并开始游戏" />
            </StackPanel>

            <!-- 启动卡片 -->
            <Border Style="{StaticResource SolarCardStyle}" Padding="24">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="准备启动" />

                        <ComboBox
                            Header="游戏实例"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind ViewModel.Instances, Mode=OneWay}"
                            PlaceholderText="还没有实例"
                            SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}" />

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.SelectedInstanceSummary, Mode=OneWay}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.LaunchCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="启动游戏" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 信息卡片：两列等宽，窄窗口下由 NavigationView 自身收缩，卡片保持最小可读宽度 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Java 运行时" />
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.JavaStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="实例数量" />
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Instances.Count, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 状态提示：InfoBar 是 WinUI 3 规定的行内提示控件 -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Message="正在加载…"
                Severity="Informational" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Success" />

            <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="刷新" />
        </StackPanel>
    </ScrollViewer>
</views:PageBase>
