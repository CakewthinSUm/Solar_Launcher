<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.VersionCreatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:models="using:Solar.Core.Models"
    xmlns:vm="using:Solar.App.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel
                Padding="{StaticResource SolarPagePadding}"
                Spacing="{StaticResource SolarSectionSpacing}">

                <!-- 标题与返回 -->
                <StackPanel Spacing="4">
                    <Button
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.BackCommand}"
                        Content="← 返回" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="创建版本" />
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.VersionSubtitle, Mode=OneWay}" />
                </StackPanel>

                <!-- 版本与名称 -->
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="12">
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasNameConflict, Mode=OneWay}"
                            Message="名称已存在"
                            Severity="Error" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                Header="游戏版本"
                                DisplayMemberPath="Id"
                                ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}" />

                            <!--
                                标题单独画：TextBox 自己的边框会被焦点状态覆盖，
                                重名时叠一层红框，输入过程中也能看到。
                            -->
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="版本名称" />
                                <Grid>
                                    <TextBox
                                        PlaceholderText="留空则按所选组件自动命名"
                                        Text="{x:Bind ViewModel.VersionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border
                                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind ViewModel.HasNameConflict, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="加载器与附加组件会在这里一次装好，完成后即可直接启动。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 组件卡片：与 PCL 的「选择组件」屏一致，每张卡展开后选版本 -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="组件" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComponentCardViewModel">
                                <Expander
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Title}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind SelectedText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind UnavailableReason, Mode=OneWay}" />
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Description}"
                                            TextWrapping="Wrap" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{x:Bind Options}"
                                                PlaceholderText="选择一个版本"
                                                SelectedItem="{x:Bind Selected, Mode=TwoWay}" />

                                            <Button
                                                Grid.Column="1"
                                                Click="ClearCard_Click"
                                                Content="清除"
                                                IsEnabled="{x:Bind HasSelection, Mode=OneWay}" />

                                            <ProgressRing
                                                Grid.Column="2"
                                                Width="20"
                                                Height="20"
                                                IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                        </Grid>

                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind LoadError, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind LoadError, Mode=OneWay, Converter={StaticResource VisibleWhenText}}" />
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 提示 -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarningTip, Mode=OneWay}"
                    Message="{x:Bind ViewModel.WarningTip, Mode=OneWay}"
                    Severity="Warning" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasInfoTip, Mode=OneWay}"
                    Message="{x:Bind ViewModel.InfoTip, Mode=OneWay}"
                    Severity="Informational" />

                <!-- 版本隔离 -->
                <Border Style="{StaticResource SolarCardStyle}">
                    <StackPanel Spacing="8">
                        <ToggleSwitch
                            Header="版本隔离"
                            IsOn="{x:Bind ViewModel.VersionIsolation, Mode=TwoWay}"
                            OffContent="关"
                            OnContent="开"
                            Toggled="Isolation_Toggled" />

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.IsolationHint, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="Success" />

                <!-- 底部留白：高度 = 按钮高度 + 下边距，滚到底时内容不会被悬浮按钮挡住 -->
                <Border Height="88" />
            </StackPanel>
        </ScrollViewer>

        <!-- 下载进度与主按钮固定在右下角，滚动时始终可见 -->
        <StackPanel
            Margin="0,0,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Spacing="8">

            <StackPanel
                Width="420"
                Spacing="4"
                Visibility="{x:Bind ViewModel.IsCreating, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                <ProgressBar Maximum="1" Value="{x:Bind ViewModel.CreateProgress, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.CreateStatus, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.CancelCreateCommand}"
                    Content="取消"
                    Visibility="{x:Bind ViewModel.IsCreating, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                <Button
                    MinWidth="180"
                    Command="{x:Bind ViewModel.CreateCommand}"
                    IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE896;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="开始下载" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</views:PageBase>
