<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="Solar.App.Views.ContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Solar.App.Views"
    xmlns:controls="using:Solar.App.Views.Controls"
    xmlns:content="using:Solar.Core.Content"
    mc:Ignorable="d">

    <!--
        Mods / 资源包 / 光影共用这一页，分区由页面顶部的分区栏决定；
        侧边栏「管理」只保留一个入口，版本分区在 VersionsPage，两边用同一条栏互相切换。
    -->
    <!-- 底部不留内边距，列表铺到窗口下边缘；留白由列表自己的 Padding 给 -->
    <Grid Padding="24,16,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 分区栏兼任页面标题 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <controls:ManageSectionBar x:Name="SectionBar" SectionSelected="SectionBar_SectionSelected" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SectionDescription, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 操作 -->
        <Border Grid.Row="1" Style="{StaticResource SolarCardStyle}">
            <StackPanel Spacing="12">
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
                    <!--
                        导入分两种：文件（zip / jar）和文件夹（解压后的资源包、光影包都合法）。
                        合成一个下拉按钮，避免工具栏在 800px 的最小窗口宽度下挤成一排。
                    -->
                    <DropDownButton
                        Content="导入"
                        Style="{StaticResource AccentButtonStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="ImportFiles_Click" Text="导入文件…" />
                                <MenuFlyoutItem Click="ImportFolder_Click" Text="导入文件夹…" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button
                        Command="{x:Bind ViewModel.OpenFolderCommand}"
                        Content="打开文件夹" />

                    <Button
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Content="刷新" />
                </StackPanel>

                <!-- 实际目录：用户可以照着这个路径手动放文件 -->
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.ContentDirectory, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ContentDirectory, Mode=OneWay, Converter={StaticResource VisibleWhenText}}" />
            </StackPanel>
        </Border>

        <!-- 内容列表 -->
        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="Success" />
                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Packs, Mode=OneWay}"
                Padding="0,0,0,16"
                SelectedItem="{x:Bind ViewModel.SelectedPack, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="content:ContentPack">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind MetaText}" />
                            </StackPanel>

                            <!-- 列表项内的操作按钮，点击由页面代码转发给 ViewModel -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Click="Reveal_Click" Content="定位" />
                                <Button Click="Delete_Click" Content="删除" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态：文件夹为空 -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="4"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</views:PageBase>
